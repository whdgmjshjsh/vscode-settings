  "latex-workshop.latex.tools": [
    {
      "args": [
        "-pdflatex",
        "-synctex=1",
        "-shell-escape",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-output-directory=%OUTDIR%",
        "-aux-directory=%AUXDIR%",
        "-emulate-aux-dir",
        "%DOC%"
      ],
