        "pdflatex",
        "pdflatex"
      ]
    },
    {
      "name": "XeLaTeX ➞ BibTeX ➞ XeLaTeX × 2",
      "tools": [
        "xelatex",
        "bibtex",
        "xelatex",
        "xelatex"
      ]
    },
    {
      "name": "LuaLaTeX ➞ BibTeX ➞ LuaLaTeX × 2",
      "tools": [
        "lualatex",
        "bibtex",
        "lualatex",
        "lualatex"
      ]
    },
    {
      "name": "PDFLaTeX ➞ BibTeX ➞ PDFLaTeX × 2",
      "tools": [
        "pdflatex",
        "bibtex",
        "pdflatex",
        "pdflatex"
      ]
    }
