{
  "[c]": {
    "editor.defaultFormatter": "xaver.clang-format",
    "editor.semanticHighlighting.enabled": true,
    "editor.suggest.insertMode": "replace",
    "editor.wordBasedSuggestions": "off"
  },
  "[cmake]": {
    "editor.defaultFormatter": "ms-vscode.cmake-tools"
  },
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.semanticHighlighting.enabled": true,
    "editor.suggest.insertMode": "replace",
    "editor.wordBasedSuggestions": "off"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[latex]": {
    "editor.formatOnSave": false,
    "editor.suggestSelection": "recentlyUsedByPrefix"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": false
  },
  "[typst-code]": {
    "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?"
  },
  "[typst]": {
    "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?"
  },
  "better-comments.highlightPlainText": true,
  "better-comments.tags": [
    {
      "backgroundColor": "transparent",
      "bold": false,
      "color": "#FF2D00",
      "italic": false,
      "strikethrough": false,
      "tag": "!",
      "underline": false
    },
    {
      "backgroundColor": "transparent",
      "bold": false,
      "color": "#3498DB",
      "italic": false,
      "strikethrough": false,
      "tag": "?",
      "underline": false
    }
  ],
  "clang-format.executable": "/usr/bin/clang-format",
  "clang-format.style": "Google",
  "clangd.arguments": [
    "--pretty",
    "--log=verbose",
    "--background-index",
    "--background-index-priority=normal",
    "--all-scopes-completion",
    "--clang-tidy",
    "--compile-commands-dir=${workspaceFolder}/build",
    "--completion-parse=auto",
    "--completion-style=detailed",
    "--query-driver=/usr/bin/clang++",
    "--enable-config",
    "--function-arg-placeholders=true",
    "--header-insertion-decorators",
    "--header-insertion=never",
    "--pch-storage=memory",
    "--ranking-model=decision_forest",
    "-j=8",
    "--limit-references=1000"
  ],
  "clangd.checkUpdates": false,
  "clangd.detectExtensionConflicts": true,
  "clangd.fallbackFlags": [
    "-pedantic",
    "-Wall",
    "-Wextra",
    "-I.",
    "-Wcast-align",
    "-Wdouble-promotion",
    "-Wformat=2",
    "-Wimplicit-fallthrough",
    "-Wmisleading-indentation",
    "-Wnon-virtual-dtor",
    "-Wnull-dereference",
    "-Wold-style-cast",
    "-Woverloaded-virtual",
    "-Wpedantic",
    "-Wshadow",
    "-Wunused",
    "-pthread",
    "-fuse-ld=lld",
    "-fsanitize=address",
    "-fsanitize=undefined",
    "-stdlib=libc++"
  ],
  "clangd.onConfigChanged": "restart",
  "clangd.serverCompletionRanking": true,
  "cmake.configureOnOpen": true,
  "cmake.pinnedCommands": [
    "workbench.action.tasks.configureTaskRunner",
    "workbench.action.tasks.runTask"
  ],
  "debugpy.debugJustMyCode": false,
  "debugpy.showPythonInlineValues": true,
  "diffEditor.ignoreTrimWhitespace": true,
  "editor.accessibilitySupport": "off",
  "editor.bracketPairColorization.enabled": true,
  "editor.cursorSmoothCaretAnimation": "explicit",
  "editor.cursorStyle": "line-thin",
  "editor.fontFamily": "Google Sans Code NF",
  "editor.fontLigatures": true,
  "editor.fontSize": 11,
  "editor.fontVariations": false,
  "editor.formatOnPaste": false,
  "editor.formatOnSave": false,
  "editor.formatOnType": false,
  "editor.guides.bracketPairs": true,
  "editor.guides.indentation": false,
  "editor.inlayHints.enabled": "off",
  "editor.inlineSuggest.enabled": true,
  "editor.inlineSuggest.showToolbar": "always",
  "editor.lineNumbers": "on",
  "editor.minimap.autohide": "mouseover",
  "editor.minimap.enabled": false,
  "editor.minimap.renderCharacters": false,
  "editor.minimap.showSlider": "always",
  "editor.minimap.size": "fit",
  "editor.mouseWheelZoom": true,
  "editor.scrollbar.horizontalScrollbarSize": 6,
  "editor.scrollbar.verticalScrollbarSize": 6,
  "editor.smoothScrolling": true,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.unicodeHighlight.allowedLocales": {
    "zh-hans": true
  },
  "editor.wordBasedSuggestions": "off",
  "editor.wordWrap": "off",
  "files.associations": {
    "*.cmake.in": "cmake",
    "*.cpp.in": "cpp",
    "*.h": "c",
    "*.h.in": "cpp",
    "*.html": "html",
    "*.py.in": "python",
    "*.pyi.in": "python",
    "*requirements*.in": "pip-requirements",
    "*requirements*.txt": "pip-requirements",
    ".clang-format": "yaml",
    ".clang-tidy": "yaml",
    ".coveragerc": "ini",
    ".flake8": "ini",
    "Makefile.*": "makefile"
  },
  "files.exclude": {
    "**/*.py[co]": true,
    "**/*_cache/": true,
    "**/.DS_Store": true,
    "**/.classpath": true,
    "**/.factorypath": true,
    "**/.git": true,
    "**/.hg": true,
    "**/.history": true,
    "**/.idea": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.svn": true,
    "**/CVS": true,
    "**/Thumbs.db": true,
    "**/__pycache__": true
  },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "flake8.args": [
    "--max-line-length=120",
    "--max-doc-length=120"
  ],
  "flake8.importStrategy": "fromEnvironment",
  "git-graph.commitDetailsView.fileView.fileTree.compactFolders": true,
  "git-graph.commitDetailsView.fileView.type": "File Tree",
  "git-graph.referenceLabels.combineLocalAndRemoteBranchLabels": true,
  "git-graph.repository.commits.order": "date",
  "git-graph.repository.showRemoteBranches": true,
  "git-graph.repository.showTags": true,
  "git-graph.repository.showUncommittedChanges": true,
  "git.autoStash": true,
  "git.autofetch": true,
  "git.confirmSync": true,
  "git.openRepositoryInParentFolders": "always",
  "git.pruneOnFetch": true,
  "gitHistory.hideCommitViewExplorer": false,
  "gitHistory.showEditorTitleMenuBarIcons": true,
  "github.copilot.enable": {
    "*": true,
    "cpp": false,
    "markdown": false,
    "plaintext": false,
    "scminput": false
  },
  "github.copilot.selectedCompletionModel": "",
  "github.gitProtocol": "ssh",
  "githubPullRequests.defaultMergeMethod": "squash",
  "githubPullRequests.pullBranch": "never",
  "githubPullRequests.terminalLinksHandler": "github",
  "gitlens.advanced.messages": {
    "suppressIntegrationRequestTimedOutWarning": true
  },
  "gitlens.defaultDateFormat": "MMMM Do, YYYY HH:mm",
  "gitlens.defaultDateShortFormat": "MMMM D, YYYY",
  "gitlens.defaultTimeFormat": "HH:mm",
  "gitlens.graph.layout": "editor",
  "gitlens.rebaseEditor.openOnPausedRebase": false,
  "gitlens.telemetry.enabled": false,
  "gitlens.views.worktrees.showStashes": true,
  "isort.args": [
    "--atomic",
    "--profile=black",
    "--line-length=100",
    "--lines-after-imports=2",
    "--remove-redundant-aliases",
    "--extra-builtin=typing_extensions"
  ],
  "isort.importStrategy": "fromEnvironment",
  "latex-workshop.formatting.latex": "latexindent",
  "latex-workshop.formatting.latexindent.args": [
    "-c",
    "%DIR%",
    "%TMPFILE%",
    "-y",
    "defaultIndent: '%INDENT%', verbatimEnvironments:nameAsRegex:name: '\\w+code\\*?'"
  ],
  "latex-workshop.intellisense.package.enabled": true,
  "latex-workshop.intellisense.unimathsymbols.enabled": true,
  "latex-workshop.latex.autoBuild.cleanAndRetry.enabled": true,
  "latex-workshop.latex.autoBuild.interval": 300000,
  "latex-workshop.latex.autoBuild.run": "onFileChange",
  "latex-workshop.latex.autoClean.run": "onFailed",
  "latex-workshop.latex.auxDir": "%OUTDIR%/.aux",
  "latex-workshop.latex.clean.fileTypes": [
    "*.xdv",
    "*.aux",
    "*.bbl",
    "*.bcf",
    "*.blg",
    "*.idx",
    "*.ind",
    "*.lof",
    "*.lot",
    "*.out",
    "*.toc",
    "*.acn",
    "*.acr",
    "*.alg",
    "*.glg",
    "*.glo",
    "*.gls",
    "*.ist",
    "*.fls",
    "*.log",
    "*.nav",
    "*.snm",
    "*.vrb",
    "*.run.xml",
    "*.fdb_latexmk",
    "*.synctex(busy)",
    "*.synctex.gz(busy)",
    "_minted-*/**",
    "_minted-*/"
  ],
  "latex-workshop.latex.clean.method": "glob",
  "latex-workshop.latex.clean.subfolder.enabled": true,
  "latex-workshop.latex.magic.args": [
    "-synctex=1",
    "-shell-escape",
    "-interaction=nonstopmode",
    "-file-line-error",
    "-output-directory=%OUTDIR%",
    "-aux-directory=%AUXDIR%",
    "-emulate-aux-dir",
    "%DOC%"
  ],
  "latex-workshop.latex.magic.bib.args": [
    "--output-directory=%OUTDIR%",
    "%DOCFILE%"
  ],
  "latex-workshop.latex.outDir": "%DIR%/out",
  "latex-workshop.latex.recipe.default": "lastUsed",
  "latex-workshop.latex.recipes": [
    {
      "name": "Latexmk (XeLaTeX)",
