      ]
    },
    {
      "name": "LuaLaTeX",
      "tools": [
        "lualatex"
      ]
    },
    {
      "name": "PDFLaTeX",
      "tools": [
        "pdflatex"
      ]
    },
    {
      "name": "Biber",
      "tools": [
